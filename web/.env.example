# ==============================================================================
# Parloora Production Environment Configuration Template
# Copy this file to .env.local for development, or add variables to Vercel Settings
# ==============================================================================

# ── SUPABASE (Database, Auth & Storage) ──────────────────────────────────────
# Obtain from: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...your_service_role_secret_key

# ── GOOGLE MAPS (Location Autocomplete & Map View) ───────────────────────────
# Obtain from: Google Cloud Console > APIs & Services > Credentials
# Enable: Maps JavaScript API, Places API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...your_google_maps_api_key

# ── SITE URL (Canonical Production Domain) ───────────────────────────────────
# In production, set to your custom domain or Vercel URL
NEXT_PUBLIC_SITE_URL=https://parloora.vercel.app

# ── STRIPE (International Credit/Debit Card Checkout) ─────────────────────────
# Obtain from: https://dashboard.stripe.com/apikeys
# Test keys begin with pk_test_ and sk_test_; Live keys begin with pk_live_ and sk_live_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
# From Stripe Dashboard > Developers > Webhooks (endpoint: /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret

# ── SSLCOMMERZ (Bangladesh Cards, Mobile Banking & Net Banking) ───────────────
# Register at: https://developer.sslcommerz.com/
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_password
# Set to "true" for production live merchant account, "false" for sandbox testing
SSLCOMMERZ_IS_LIVE=false

# ── BKASH (Direct Tokenized Checkout) ─────────────────────────────────────────
# Register at: https://developer.bka.sh/
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
# Set to "true" for live bKash credentials, "false" for sandbox
BKASH_IS_LIVE=false

# ── RESEND (Transactional Email Delivery) ────────────────────────────────────
# Free tier: 3,000 emails/month at https://resend.com
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@parloora.com
RESEND_FROM_NAME=Parloora

# ── TWILIO (SMS Booking Reminders & Notifications) ────────────────────────────
# Obtain from: https://console.twilio.com
TWILIO_ACCOUNT_SID=ACyour_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── CRON SECRET (Security for /api/notifications/remind) ─────────────────────
# Generate a 32+ character random secret string
CRON_SECRET=generate_a_secure_random_string_here_32_chars_min

# ── OPENAI (AI Semantic Search & Vector Embeddings) ──────────────────────────
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your_openai_api_key
